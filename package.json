    "lucide-react": "^0.460.0",
    "next": "15.5.28",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "dotenv": "^17.2.2",
    "prisma": "7.10.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "8.5.29"
